# testnet2 gateway API key — this is NOT a secret, it's published in the
# sphere-sdk repo's own .env.example. Copy the real value from there:
# https://github.com/unicity-sphere/sphere-sdk/blob/main/.env.example
SPHERE_TESTNET_API_KEY=sk_...

# Reputation coin (self-minted on testnet). Any hex coinId works — mint it
# once with the poster agent and reuse the same id across all agents.
REPUTATION_COIN_ID=

# --- Poster agent (the one hiring) ---
POSTER_MNEMONIC=
POSTER_NAMETAG=guild-poster

# --- Bidder agent (the one taking jobs) ---
BIDDER_MNEMONIC=
BIDDER_NAMETAG=guild-bidder-01

# Shared guild hall group chat id — leave empty on first run, the poster
# agent will create it and print the id to paste back in here.
GUILD_GROUP_ID=
